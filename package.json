{
  "name": "dineriko",
  "version": "2.3.0",
  "private": true,
  "type": "module",
  "description": "Control de gastos e ingresos mensuales, sin conexión y sin cuentas — Dineriko.",
  "scripts": {
    "build": "esbuild src/main.jsx --bundle --minify --format=iife --target=safari15 --outfile=bundle.js",
    "build:beta": "esbuild src/main.jsx --bundle --minify --format=iife --target=safari15 --outfile=bundle-beta.js",
    "build:dev": "esbuild src/main.jsx --bundle --format=iife --target=safari15 --outfile=bundle.js --sourcemap",
    "watch": "npm run build:dev -- --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "www": "node scripts/www.mjs",
    "ios:sync": "npm run build && npm run www && npx cap sync ios"
  },
  "dependencies": {
    "@capacitor/core": "8.5.3",
    "@capacitor/filesystem": "8.1.4",
    "@capacitor/ios": "8.5.3",
    "@capacitor/local-notifications": "8.3.1",
    "@capacitor/share": "8.0.3",
    "@capgo/capacitor-native-biometric": "8.8.2",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@capacitor/cli": "8.5.3",
    "esbuild": "^0.27.7",
    "jsdom": "^30.0.1",
    "vitest": "^4.1.11"
  }
}
